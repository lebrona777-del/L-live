// ========================================================
// FETCH
// ========================================================

async function fetchText(url) {

  try {

    const controller =
      new AbortController();

    const timeout =
      setTimeout(
        () => controller.abort(),
        15000
      );

    const response =
      await fetch(
        url,
        {
          headers: {
            "User-Agent":
              "Mozilla/5.0 L-LIVE",
            "Accept":
              "text/html,application/xhtml+xml"
          },
          signal:
            controller.signal
        }
      );

    clearTimeout(timeout);

    if (!response.ok) {

      throw new Error(
        `HTTP ${response.status}`
      );

    }

    return await response.text();

  } catch (error) {

    console.error(
      "SOURCE ERROR:",
      url,
      error.message
    );

    return "";

  }

}


// ========================================================
// HTML CLEAN
// ========================================================

function decodeHTML(text) {

  return String(text || "")

    .replace(
      /&nbsp;/gi,
      " "
    )

    .replace(
      /&amp;/gi,
      "&"
    )

    .replace(
      /&quot;/gi,
      '"'
    )

    .replace(
      /&#39;|&#x27;/gi,
      "'"
    )

    .replace(
      /&lt;/gi,
      "<"
    )

    .replace(
      /&gt;/gi,
      ">"
    );

}


function cleanText(text) {

  return decodeHTML(
    String(text || "")
      .replace(
        /<script[\s\S]*?<\/script>/gi,
        ""
      )
      .replace(
        /<style[\s\S]*?<\/style>/gi,
        ""
      )
      .replace(
        /<[^>]+>/g,
        " "
      )
  )
    .replace(
      /\s+/g,
      " "
    )
    .trim();

}


// ========================================================
// NORMALIZE TEAM NAME
// ========================================================

function normalizeTeamName(name) {

  return cleanText(name)

    .toLowerCase()

    .replace(
      /[-–—]/g,
      " "
    )

    .replace(
      /\s+/g,
      " "
    )

    .trim();

}


// ========================================================
// OFFICIAL LOGO DISCOVERY
// ========================================================

function extractOfficialLogos(html) {

  const logos = {};

  if (!html) {
    return logos;
  }


  const imgRegex =
    /<img\b[^>]*>/gi;

  const images =
    html.match(imgRegex) || [];


  for (const img of images) {

    const srcMatch =
      img.match(
        /\bsrc\s*=\s*["']([^"']+)["']/i
      );

    if (!srcMatch) {
      continue;
    }


    const src =
      srcMatch[1];


    if (
      src.startsWith("data:") ||
      src.startsWith("blob:")
    ) {
      continue;
    }


    const altMatch =
      img.match(
        /\balt\s*=\s*["']([^"']+)["']/i
      );


    const titleMatch =
      img.match(
        /\btitle\s*=\s*["']([^"']+)["']/i
      );


    const name =
      altMatch?.[1] ||
      titleMatch?.[1] ||
      "";


    if (!name) {
      continue;
    }


    const key =
      normalizeTeamName(name);


    logos[key] =
      makeAbsoluteURL(
        src,
        BASE_GFF
      );

  }


  const rowRegex =
    /<tr\b[^>]*>[\s\S]*?<\/tr>/gi;

  const rows =
    html.match(rowRegex) || [];


  for (const row of rows) {

    const rowText =
      cleanText(row);


    if (!rowText) {
      continue;
    }


    const srcMatches =
      [
        ...row.matchAll(
          /<img\b[^>]*\bsrc\s*=\s*["']([^"']+)["'][^>]*>/gi
        )
      ];


    if (!srcMatches.length) {
      continue;
    }


    const cells =
      rowText
        .split(/\s{2,}/)
        .map(
          value => value.trim()
        )
        .filter(Boolean);


    for (
      const srcMatch of srcMatches
    ) {

      const src =
        srcMatch[1];


      const logo =
        makeAbsoluteURL(
          src,
          BASE_GFF
        );


      for (
        const cell of cells
      ) {

        if (
          cell.length < 2 ||
          cell.length > 70
        ) {
          continue;
        }


        if (
          /^\d+$/.test(cell)
        ) {
          continue;
        }


        const key =
          normalizeTeamName(cell);


        if (
          !logos[key]
        ) {

          logos[key] =
            logo;

        }

      }

    }

  }


  return logos;

}


// ========================================================
// ABSOLUTE URL
// ========================================================

function makeAbsoluteURL(
  src,
  base
) {

  try {

    return new URL(
      src,
      base
    ).href;

  } catch {

    return src;

  }

}


// ========================================================
// LOGO CACHE
// ========================================================

const LOGO_CACHE = {

  data: {},

  loaded: false,

  loading: null

};


// ========================================================
// LOAD OFFICIAL LOGOS
// ========================================================

async function loadOfficialLogos() {

  if (
    LOGO_CACHE.loaded
  ) {

    return LOGO_CACHE.data;

  }


  if (
    LOGO_CACHE.loading
  ) {

    return LOGO_CACHE.loading;

  }


  LOGO_CACHE.loading =
    (async () => {

      const map = {};


      const competitions =
        SOURCES
          .football
          .competitions;


      for (
        const competition
        of competitions
      ) {

        if (
          !competition.official
        ) {
          continue;
        }


        const html =
          await fetchText(
            competition.official
          );


        if (!html) {
          continue;
        }


        const found =
          extractOfficialLogos(
            html
          );


        Object.assign(
          map,
          found
        );

      }


      LOGO_CACHE.data =
        map;

      LOGO_CACHE.loaded =
        true;

      LOGO_CACHE.loading =
        null;


      console.log(
        "L-LIVE official logos loaded:",
        Object.keys(map).length
      );


      return map;

    })();


  return LOGO_CACHE.loading;

}


// ========================================================
// TEAM
// ========================================================

function team(
  name,
  short = name
) {

  return {

    name,

    short,

    logo: "",

    logoSource:
      "official"

  };

}


// ========================================================
// ATTACH LOGO
// ========================================================

function attachLogo(
  teamObject,
  logoMap
) {

  if (!teamObject) {
    return teamObject;
  }


  const candidates = [

    teamObject.name,

    teamObject.short

  ];


  for (
    const candidate
    of candidates
  ) {

    const key =
      normalizeTeamName(
        candidate
      );


    if (
      logoMap[key]
    ) {

      return {

        ...teamObject,

        logo:
          logoMap[key]

      };

    }

  }


  return teamObject;

}


// ========================================================
// MONTHS
// ========================================================

const MONTHS = {

  "იანვარი": 1,
  "თებერვალი": 2,
  "მარტი": 3,
  "აპრილი": 4,
  "მაისი": 5,
  "ივნისი": 6,
  "ივლისი": 7,
  "აგვისტო": 8,
  "სექტემბერი": 9,
  "ოქტომბერი": 10,
  "ნოემბერი": 11,
  "დეკემბერი": 12

};


// ========================================================
// DATE
// ========================================================

function parseDateLine(
  line,
  fallbackYear = 2026
) {

  const value =
    String(line || "")
      .replace(
        /,/g,
        " "
      )
      .replace(
        /\s+/g,
        " "
      )
      .trim();


  let match =
    value.match(
      /\b(20\d{2})[-/.](\d{1,2})[-/.](\d{1,2})\b/
    );


  if (match) {

    return `${match[1]}-${String(
      match[2]
    ).padStart(2, "0")}-${String(
      match[3]
    ).padStart(2, "0")}`;

  }


  match =
    value.match(
      /(?:^|\D)(\d{1,2})\s+([ა-ჰ]+)/u
    );


  if (match) {

    const month =
      MONTHS[
        match[2]
      ];


    if (month) {

      return `${fallbackYear}-${String(
        month
      ).padStart(2, "0")}-${String(
        match[1]
      ).padStart(2, "0")}`;

    }

  }


  return null;

}


// ========================================================
// HTML → LINES
// ========================================================

function htmlToLines(html) {

  if (!html) {
    return [];
  }


  return html

    .replace(
      /<script[\s\S]*?<\/script>/gi,
      " "
    )

    .replace(
      /<style[\s\S]*?<\/style>/gi,
      " "
    )

    .replace(
      /<(br|\/p|\/div|\/li|\/tr|\/td|\/th|\/h[1-6])\b[^>]*>/gi,
      "\n"
    )

    .replace(
      /<[^>]+>/g,
      " "
    )

    .split(/\r?\n/)

    .map(
      line =>
        cleanText(line)
    )

    .filter(Boolean);

}


// ========================================================
// SCORE
// ========================================================

function parseScoreLine(
  line
) {

  const value =
    String(line || "")
      .trim();


  const match =
    value.match(
      /^([ა-ჰA-Z]{2,5})\s+(\d{1,2})\s*[:\-–—]\s*(\d{1,2})\s+([ა-ჰA-Z]{2,5})$/u
    );


  if (!match) {
    return null;
  }


  return {

    home:
      team(
        match[1]
      ),

    away:
      team(
        match[4]
      ),

    homeScore:
      Number(match[2]),

    awayScore:
      Number(match[3])

  };

}


// ========================================================
// FOOTBALL RESULTS
// ========================================================

async function getGeorgianFootballResults(
  competitionId =
    "erovnuli-liga"
) {

  const competition =
    SOURCES
      .football
      .competitions
      .find(
        item =>
          item.id ===
          competitionId
      );


  if (!competition) {
    return [];
  }


  if (
    !competition.results
  ) {

    return [];

  }


  const html =
    await fetchText(
      competition.results
    );


  if (!html) {
    return [];
  }


  const logoMap =
    await loadOfficialLogos();


  const lines =
    htmlToLines(html);


  const results = [];

  let currentDate =
    null;


  for (
    const line
    of lines
  ) {

    const date =
      parseDateLine(
        line
      );


    if (date) {

      currentDate =
        date;

      continue;

    }


    const parsed =
      parseScoreLine(
        line
      );


    if (!parsed) {
      continue;
    }


    const home =
      attachLogo(
        parsed.home,
        logoMap
      );


    const away =
      attachLogo(
        parsed.away,
        logoMap
      );


    results.push({

      sport:
        "football",

      country:
        "Georgia",

      competitionId:
        competition.id,

      competition:
        competition.name,

      status:
        "finished",

      date:
        currentDate,

      time:
        null,

      homeTeam:
        home,

      awayTeam:
        away,

      homeScore:
        parsed.homeScore,

      awayScore:
        parsed.awayScore,

      source:
        competition.results,

      events:
        []

    });

  }


  return results;

}


// ========================================================
// FIXTURES
// ========================================================

async function getGeorgianFootballFixtures(
  competitionId =
    "erovnuli-liga"
) {

  const competition =
    SOURCES
      .football
      .competitions
      .find(
        item =>
          item.id ===
          competitionId
      );


  if (!competition) {
    return [];
  }


  if (
    !competition.official
  ) {
    return [];
  }


  const html =
    await fetchText(
      competition.official
    );


  if (!html) {
    return [];
  }


  const logoMap =
    await loadOfficialLogos();


  const lines =
    htmlToLines(html);


  const fixtures = [];

  let currentDate =
    null;


  for (
    const line
    of lines
  ) {

    const date =
      parseDateLine(
        line
      );


    if (date) {

      currentDate =
        date;

      continue;

    }


    const match =
      line.match(
        /^([ა-ჰA-Z]{2,5})\s+(\d{1,2}:\d{2})\s+([ა-ჰA-Z]{2,5})$/u
      );


    if (!match) {
      continue;
    }


    const home =
      attachLogo(
        team(
          match[1]
        ),
        logoMap
      );


    const away =
      attachLogo(
        team(
          match[3]
        ),
        logoMap
      );


    fixtures.push({

      sport:
        "football",

      country:
        "Georgia",

      competitionId:
        competition.id,

      competition:
        competition.name,

      status:
        "scheduled",

      date:
        currentDate,

      time:
        match[2],

      homeTeam:
        home,

      awayTeam:
        away,

      homeScore:
        null,

      awayScore:
        null,

      source:
        competition.official,

      events:
        []

    });

  }


  return fixtures;

}


// ========================================================
// BASKETBALL
// ========================================================

async function getGeorgianBasketball() {

  return SOURCES
    .basketball
    .competitions
    .map(
      competition => ({

        sport:
          "basketball",

        country:
          "Georgia",

        competitionId:
          competition.id,

        competition:
          competition.name,

        source:
          competition.official,

        matches:
          []

      })
    );

}


// ========================================================
// RUGBY
// ========================================================

async function getGeorgianRugby() {

  return SOURCES
    .rugby
    .competitions
    .map(
      competition => ({

        sport:
          "rugby",

        country:
          "Georgia",

        competitionId:
          competition.id,

        competition:
          competition.name,

        source:
          competition.official,

        matches:
          []

      })
    );

}


// ========================================================
// LIVE
// ========================================================

function detectLiveMatches(
  matches
) {

  return (
    Array.isArray(matches)
      ? matches
      : []
  ).filter(
    match =>
      [
        "live",
        "in_progress",
        "playing"
      ].includes(
        match.status
      )
  );

}


// ========================================================
// ALL GEORGIA SPORTS
// ========================================================

async function getGeorgiaSportsData() {

  const [

    footballResults,

    footballFixtures,

    basketball,

    rugby

  ] = await Promise.all([

    getGeorgianFootballResults(),

    getGeorgianFootballFixtures(),

    getGeorgianBasketball(),

    getGeorgianRugby()

  ]);


  return {

    country:
      "Georgia",

    sports: {

      football: {

        results:
          footballResults,

        fixtures:
          footballFixtures,

        live:
          detectLiveMatches(
            footballResults
          )

      },

      basketball,

      rugby

    },

    updatedAt:
      new Date().toISOString()

  };

}


// ========================================================
// EXPORT
// ========================================================

module.exports = {

  SOURCES,

  fetchText,

  cleanText,

  htmlToLines,

  parseDateLine,

  parseScoreLine,

  extractOfficialLogos,

  loadOfficialLogos,

  getGeorgianFootballResults,

  getGeorgianFootballFixtures,

  getGeorgianBasketball,

  getGeorgianRugby,

  getGeorgiaSportsData

};
